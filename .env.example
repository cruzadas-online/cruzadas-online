# Cruzadas.online - Variáveis de Ambiente
# Portas configuradas para evitar conflito com outros serviços na máquina
CRUZADAS_WEB_PORT=5175
CRUZADAS_API_PORT=5185

# Production uses an external PostgreSQL instance. Do not commit real credentials.
ASPNETCORE_ENVIRONMENT=Production
DATABASE_PROVIDER=Npgsql
DATABASE_AUTO_MIGRATE=true
DATABASE_AUTO_SEED=true
ConnectionStrings__DefaultConnection=Host=your-postgres-host;Port=5432;Database=cruzadas;Username=cruzadas_user;Password=replace-me;SSL Mode=Require;Trust Server Certificate=true
